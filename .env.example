DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Generate a unique secret (at least 32 random characters) and use it here.
# The same value is passed to the Lavalink container by docker compose.
LAVALINK_PASSWORD=
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_SECURE=false

# YouTube search is enabled through the included youtube-source plugin.
LAVALINK_SEARCH_PLATFORM=ytsearch

# Web dashboard
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
DASHBOARD_USERS_FILE=data/users.json

# Optional Spotify Web API application credentials for Spotify playlists.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
