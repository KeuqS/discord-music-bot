DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Generate a unique secret (at least 32 random characters) and use it here.
# The same value is passed to the Lavalink container by docker compose.
LAVALINK_PASSWORD=
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_SECURE=false

# SoundCloud search is enabled in the included Lavalink config.
LAVALINK_SEARCH_PLATFORM=scsearch

# Web dashboard
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
